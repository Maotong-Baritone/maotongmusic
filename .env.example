# 复制为 .env 后填写。不要提交真实密码或密钥。
ADMIN_USER=admin
ADMIN_PASS=replace-with-a-long-random-password
FLASK_SECRET_KEY=replace-with-at-least-32-random-bytes
ADMIN_PORT=5000
AUTO_OPEN_BROWSER=1
BACKUP_KEEP_COUNT=10
SUBMISSION_MAX_MB=50
BATCH_UPLOAD_MAX_FILES=30
BATCH_UPLOAD_MAX_MB=500
SUBMISSIONS_DB=submissions.db
PENDING_UPLOAD_DIR=private_uploads

# 对象存储迁移（当前首选 Cloudflare R2，也兼容其他 S3 服务）
# 密钥只保存在本机 .env，绝不能写进 site-config.json 或提交到 Git。
SCORE_STORAGE_BUCKET=maotongmusic-scores
# R2 可只填写 Account ID，脚本会自动生成 S3 API endpoint，region 自动使用 auto。
SCORE_STORAGE_R2_ACCOUNT_ID=
# 非 R2 服务或需要覆盖自动值时再填写下面两项。
SCORE_STORAGE_ENDPOINT_URL=
SCORE_STORAGE_REGION=auto
SCORE_STORAGE_ACCESS_KEY_ID=
SCORE_STORAGE_SECRET_ACCESS_KEY=
